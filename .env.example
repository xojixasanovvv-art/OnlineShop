# Bo'sh qoldirmang! Kalit yarating:
#   python -c "import secrets; print(secrets.token_hex(32))"
# Bo'sh yoki namuna kalit bo'lsa dev rejimida tasodifiy kalit ishlatiladi,
# production (APP_ENV=production) da esa ilova ishga tushmaydi.
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
DATABASE_URL=postgresql://postgres:1@localhost:5432/postgres
# Telegram bot — @BotFather dan token oling va admin chat id ni kiriting
# Bot token bo'sh bo'lsa demo rejim — TG ga yuborilmaydi, console ga log chiqadi
BOT_TOKEN=
ADMIN_TG_ID=
# MinIO S3 — rasm, avatar, chek uchun
# Docker da minio:9000, local da localhost:9000
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=onlineshop
MINIO_SECURE=false
# Email (parol tiklash kodi) — Gmail uchun 2-Step Verification + App Password (16 belgi).
# Oddiy Gmail paroli ishlamaydi. Tekshirish: python check_email.py
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Gmail'da bu manzil SMTP_USER bilan bir xil bo'lishi kerak
SMTP_FROM=
SMTP_STARTTLS=true
